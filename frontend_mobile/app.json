{
  "expo": {
    "name": "CardCircle",
    "slug": "cardcircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0D0F",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cardcircle.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0D0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0A0D0F"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CardCircle needs photos for order proof and chat images."
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "CardCircle uses your contacts to show the name you saved for someone."
        }
      ]
    ]
  }
}
