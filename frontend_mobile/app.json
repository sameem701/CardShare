{
  "expo": {
    "name": "CardShare",
    "slug": "cardshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0D0F",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cardshare.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0D0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0A0D0F"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CardShare needs photos for order proof and chat images."
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "CardShare uses your contacts to show the name you saved for someone."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "54b24d26-0680-480a-bae6-ee30ed4f6ef6"
      }
    }
  }
}
